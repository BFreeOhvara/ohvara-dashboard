# ============================================================
# Ohvara Dashboard — Environment Variables
# Copy to .env.local and fill in values
# NEVER commit .env.local to git
# ============================================================

# Supabase (from Project Settings → API)
VITE_SUPABASE_URL=https://jjextitmbptoaolacocs.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
# Use the "publishable" key (starts sb_publishable_...) from Project Settings → API,
# not a legacy anon/service_role JWT — those were disabled 2026-06-14.

# Twilio (browser dialer — fill in when Twilio account is provisioned)
# WIRE-THIS: See src/lib/twilio.js for full setup instructions
VITE_TWILIO_TWIML_APP_SID=

# Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# Do NOT put these in .env.local — they are server-side only
# ANTHROPIC_API_KEY=your-anthropic-key
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Scraper scripts (scrapers/indeed-scraper.js + scrapers/googlemaps-scraper.js)
# These run server-side via `npm run scrape:indeed` or `npm run scrape:googlemaps`
# NEVER expose SUPABASE_SERVICE_ROLE to the browser/client
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE=your-service-role-key-here
